						<validation:is-time doc:name="Timestamp Is time" doc:id="5e5831c5-ec96-4778-948f-4edc7430332a" time='#[payload.Timestamp default ""&#93;' pattern='#["MM/dd/yy HH:mm"&#93;' message="Timestamp is not in valid format"/>
					</validation:all> [STUDIO] -->
				</batch:step>
				<!-- [STUDIO:"Batch_Step1"]<batch:step name="Batch_Step1" doc:id="1dae68ae-ca1c-4295-98c4-e2c9d725917f" acceptPolicy="ONLY_FAILURES">
