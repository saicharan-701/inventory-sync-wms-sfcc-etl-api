						<set-variable value='#["errorRecords"&#93;' doc:name="Set Variable" doc:id="67768930-6927-43f2-bd08-82e021922bc3" variableName="storeId" />
						<set-payload value="#[errorRecords:payload&#93;" doc:name="Set Payload" doc:id="326d1293-87b0-4b37-a543-627334c1e688" />
						<flow-ref doc:name="batch-pocSub_Flow" doc:id="47af4858-730b-4769-829b-d60a3f9bc329" name="batch-pocSub_Flow"/>
						<file:write doc:name="Write" doc:id="541110ed-46fd-4c1b-84ef-b8aeca9fa0b4" path='#["C:\\Users\\chint\\OneDrive\\Documents\\batch-poc\\error\\" ++ "inventory_" ++ ((now() &gt;&gt; "UTC") as String {format : "dd-MM-yyyy"}) ++ ".csv"&#93;' />
						<remove-variable doc:name="storeId" doc:id="036114cf-99f4-44f4-b7df-c651b43092e3" variableName="storeId" />
					</batch:aggregator>
					<ee:transform doc:name="Transform Message" doc:id="06297698-324e-4408-a5b1-e4044f72dc8c" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
&#45;&#45;-
