	<flow name="inventory-bacth-processFlow" doc:id="89460d3e-5788-4f4d-8b69-36a968affa09" >
		<logger level="INFO" doc:name="batch-process-start" doc:id="54d2b02d-10f0-4ce3-a670-02934e695dbe" message="Reading_File_From_Location" />
		<set-variable value='#[now() &gt;&gt; "UTC"]' doc:name="start-time" doc:id="2d6aa2e0-1bd6-4bd5-b856-34a44b2ca368" variableName="startTime"/>
		<set-variable value='#["inventory_" ++ ((now() &gt;&gt; "UTC") as String {format : "dd-MM-yyyy"}) ++ ".csv"]' doc:name="fileName" doc:id="96eb947c-4e4f-4d95-89a4-7b5961009f71" variableName="fileName"/>
		<file:read
     path='#["C:\\Users\\chint\\OneDrive\\Documents\\batch-poc\\input\\" ++ vars.fileName]'
     outputMimeType="application/csv; streaming=true; header=true"/>
		<remove-variable doc:name="fileName" doc:id="d331ffa8-6457-4c7b-adb7-b07da09c0128" variableName="fileName"/>
		<batch:job jobName="batch-pocBatch_Job" doc:id="7b62b037-e2fc-4297-87c3-81e0652cc1f3" maxFailedRecords="-1" blockSize="1200" schedulingStrategy="ROUND_ROBIN">
			<batch:process-records >
				<batch:step name="Batch_Step" doc:id="5d98d19d-a9eb-4744-9aa0-ea58e6f3caac" >
					<batch:aggregator doc:name="Batch Aggregator" doc:id="16f92902-0a37-43f5-90c5-0527b57bbe59" size="600">
						<kafka:publish doc:name="Publish" doc:id="3370136a-cafe-4d71-879c-9886377163ad" config-ref="Apache_Kafka_Producer_configuration" topic="batch-store" partition="0" key="#[uuid()]">
							<reconnect />
							<kafka:message ><![CDATA[#[//output Json --- flatten(vars.records.payload)
output application/csv header=true --- flatten(vars.records.payload)]]]></kafka:message>
						</kafka:publish>
					
</batch:aggregator>
					<!-- [STUDIO:"All"]<validation:all doc:name="All" doc:id="dd2f22e4-b8b4-46ec-8f03-71452bec4cf2" >
